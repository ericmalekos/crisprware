# 1. Ignore everything in the repository
*

# Allow
!.gitignore

!MANIFEST.in
!README.md
!environment.yml
!license.txt
!pyproject.toml
!.readthedocs.yaml

# Directories: must un-ignore both the dir and its contents
!.github/
!.github/**
!annotations/
!annotations/**
!colab_notebooks/
!colab_notebooks/**
!crispr-ots/
!crispr-ots/**
!crisprware/
!crisprware/**
!conda-recipe/
!conda-recipe/**
!dist/
!dist/**
!docker/
!docker/**
!docs/
!docs/**
!images/
!images/**
!parasol_scripts/
!parasol_scripts/**
!scripts/
!scripts/**
!slurm/
!slurm/**
!tests/
!tests/**
!tools/
!tools/**

# Re-ignore generated/build artifacts (must come after un-ignore rules)
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
docs/build/

# Rust workspace artifacts (crispr-ots/)
crispr-ots/target/
crispr-ots/**/*.rs.bk
crispr-ots/**/*.crot
crispr-ots/**/*.profraw
crispr-ots/**/flamegraph.svg
crispr-ots/**/perf.data*
# Out-of-tree build dirs (target-gpu, target-mm, target-mm-gpu, ...) plus build/test
# logs and generated test artifacts. The glob is deliberate: each validated binary gets
# its own tree so a rebuild cannot overwrite a binary another project's md5 guard pins.
crispr-ots/target-*/
crispr-ots/gpu_build.log
crispr-ots/dualmat_build.*
# Generated genome-wide Cas12a track outputs (large; not source)
crispr-ots/cas12a_tracks/
tests/test_data/**/*.fai
tests/test_data/**/*.dna
